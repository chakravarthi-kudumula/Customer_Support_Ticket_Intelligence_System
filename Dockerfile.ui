FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TICKET_API_URL=http://api:8000

WORKDIR /app

COPY docker/requirements-ui.txt /tmp/requirements-ui.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/requirements-ui.txt

COPY app ./app

EXPOSE 8501

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
